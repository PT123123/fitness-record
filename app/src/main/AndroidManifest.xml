<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 强提醒所需权限 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />           <!-- Android 13+ 通知 -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />       <!-- 锁屏全屏弹窗 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />          <!-- 悬浮窗（需在设置里手动授权） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".FitnessApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 锁屏/全屏强提醒弹窗 -->
        <activity
            android:name=".AlarmActivity"
            android:exported="false"
            android:theme="@style/Theme.AlarmOverlay"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true" />

        <!-- 悬浮窗（SYSTEM_ALERT_WINDOW），可选增强 -->
        <service
            android:name=".OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- Android 14+: specialUse 类型必须声明用途 -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE"
                android:value="健身倒计时归零时在其它应用上层显示休息提醒悬浮窗" />
        </service>

    </application>
</manifest>
