<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 强提醒所需权限 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />           <!-- Android 13+ 通知 -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />               <!-- 锁屏/后台准点提醒 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />          <!-- Android 12/12L 精确闹钟 -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />       <!-- 锁屏全屏弹窗 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />          <!-- 悬浮窗（需在设置里手动授权） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" /> <!-- 防杀后台 -->

    <application
        android:name=".FitnessApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 长按 App 图标弹出的快捷菜单（shortcuts.xml） -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- 长按图标「添加热力图控件」菜单项的中转页：透明、即刻关闭，只触发系统钉选流程 -->
        <activity
            android:name=".AddWidgetActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.TransparentPin" />

        <!-- 锁屏/全屏强提醒弹窗 -->
        <activity
            android:name=".AlarmActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.AlarmOverlay"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true" />

        <!-- 锁屏通知上的操作按钮（关闭/再休息1分钟）：全屏弹窗没弹出时也能在锁屏上直接操作 -->
        <receiver
            android:name=".AlarmActionReceiver"
            android:exported="false" />

        <!-- 悬浮窗（SYSTEM_ALERT_WINDOW），可选增强 -->
        <service
            android:name=".OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- Android 14+: specialUse 类型必须声明用途 -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE"
                android:value="健身倒计时归零时在其它应用上层显示休息提醒悬浮窗" />
        </service>

        <!-- 倒计时前台服务：保活进程，锁屏/后台到点准时提醒（配合系统精确闹钟兜底） -->
        <service
            android:name=".CountdownService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE"
                android:value="健身休息倒计时期间保持进程存活，确保锁屏/后台到点准时提醒" />
        </service>

        <!-- 桌面 2x2 训练热力图控件：按月历显示哪天练了什么（数据由 App 内记录变更时同步） -->
        <receiver
            android:name=".HeatmapWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/heatmap_widget_info" />
        </receiver>

        <!-- requestPinAppWidget 钉选结果回调（成功时带 EXTRA_APPWIDGET_ID） -->
        <receiver
            android:name=".WidgetPinCallbackReceiver"
            android:exported="false" />

        <!-- 笔记导出：把缓存目录里的备份文件授权给系统分享面板的目标应用读取 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
